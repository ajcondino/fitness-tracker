# Copy this file to .env.local and fill in real values.
# EXPO_PUBLIC_ vars are inlined into the JS bundle at build time (client-visible) —
# see https://docs.expo.dev/guides/environment-variables/

# Sentry DSN (Client Keys / DSN in Sentry project settings). Leave unset to disable Sentry locally.
EXPO_PUBLIC_SENTRY_DSN=
